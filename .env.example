# Add your Google Gemini API key here, then restart the app.
# With no key, the existing local resume parser continues to work.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=30

# Optional process environment overrides. Set these in PowerShell before running start.ps1.
# INCEPTA_BATCH_MAX_FILES=30
# INCEPTA_RESUME_MAX_MB=15
# INCEPTA_RESUME_MAX_PAGES=50
# INCEPTA_EXTRACTION_WORKERS=2
